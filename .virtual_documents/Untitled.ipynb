from ScrapUtils import *


baseurl = 'https://www.bergzeit.ch/'



scraper = ScrapExecutor()
links = []
for page in range(1, 8):
    links.extend(scraper.execute(f'https://www.bergzeit.ch/schuhe/kletterschuhe/?p={page}&sortBy=ct', baseurl, 'products-list-page-preloader__links'))

print(len(links))


scraper(links)



