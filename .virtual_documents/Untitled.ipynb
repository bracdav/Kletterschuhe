import requests
from bs4 import BeautifulSoup



baseurl = 'https://www.bergzeit.ch/'



productlinks = []

for page in range(1, 8):
    r = requests.get(f'https://www.bergzeit.ch/schuhe/kletterschuhe/?p={page}&sortBy=ct')
    soup = BeautifulSoup(r.content, 'lxml')
    product_list = soup.find_all('div', class_='products-list-page-preloader__links')
    
    for item in product_list:
        for link in item.find_all('a', href = True):
            productlinks.append(baseurl + link['href'])


from ScrapUtils import *


product_links = ProductLinks(baseurl, 'products-list-page-preloader__links')



product_links.Links



