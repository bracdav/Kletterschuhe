import numpy as np

def convert_size(df):
    res = {}
    for size in df['availableSizes'].unique():
        if 'US' in size:
            res[size] = np.round(float(size.replace('US ', '').replace(',','.').strip()), 1) + 32
        elif 'UK' in size:
            res[size] = np.round(float(size.replace('UK ', '').replace(',','.').strip()), 1) + 33
        elif '-' in size:
            res[size] = np.round(float(size.split('-')[0]), 1)
        else:
            res[size] = np.round(float(size), 1)
    return res


